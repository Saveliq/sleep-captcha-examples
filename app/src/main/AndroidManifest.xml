<?xml version="1.0" encoding="utf-8"?>
<manifest
    package="com.urbandroid.sleep.captcha.example"
    xmlns:android="http://schemas.android.com/apk/res/android"
    >

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
    >

        <activity
		    android:name=".HardMathCaptchaActivity"
		    android:launchMode="singleTop"
		    android:label="@string/captcha_math_label"
		    android:exported="true">
		
		    <meta-data
		        android:name="com.urbandroid.sleep.captcha.meta.has_difficulty"
		        android:value="true" />
		
		    <intent-filter>
		        <action android:name="com.urbandroid.sleep.captcha.intent.action.OPEN" />
		    </intent-filter>
		</activity>


    </application>

</manifest>
