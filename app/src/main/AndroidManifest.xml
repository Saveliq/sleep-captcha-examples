<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.urbandroid.sleep.captcha.example">

    <application
        android:allowBackup="true"
        android:label="@string/app_name">

        <!-- HARD MATH CAPTCHA -->
        <activity
            android:name=".HardMathCaptchaActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/captcha_math_label">

            <meta-data
                android:name="com.urbandroid.sleep.captcha.meta.has_difficulty"
                android:value="true" />

            <intent-filter>
                <!-- mandatory: иначе Sleep не найдёт капчу -->
                <action android:name="com.urbandroid.sleep.captcha.intent.action.OPEN" />
                <!-- важно для implicit intent -->
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- REVERSE CAPTCHA (твой ReverseCaptchaActivity) -->
        <activity
            android:name=".ReverseCaptchaActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/captcha_label">

            <meta-data
                android:name="com.urbandroid.sleep.captcha.meta.has_difficulty"
                android:value="true" />

            <intent-filter>
                <action android:name="com.urbandroid.sleep.captcha.intent.action.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>

</manifest>
